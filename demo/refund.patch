 	})
 	return res, nil
 }
+
+// Refund reverses an approved transaction: the account is credited and the
+// transaction is marked refunded.
+func Refund(st *store.Store, txnID string) error {
+	var err error
+	st.Update(func(tx *store.Tx) {
+		t, ok := tx.Transaction(txnID)
+		if !ok || t.Status != "approved" {
+			err = fmt.Errorf("transaction %s is not refundable", txnID)
+			return
+		}
+		c, _ := tx.Card(t.CardID)
+		a, _ := tx.Account(c.AccountID)
+		a.Balance += t.Amount
+		tx.PutAccount(a)
+		t.Status = "refunded"
+		tx.PutTransaction(t)
+	})
+	return err
+}
